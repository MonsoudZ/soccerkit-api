# Server
#
# ENV is required and has no default. It picks whether this process gets the
# development-only escape hatches — a placeholder JWT secret, DEV_APPLE_BYPASS, no
# throttle on the credential endpoints. Anything other than development or test counts
# as deployed and those are refused at boot, so set it to production/staging/... on a
# server and leave it as development here.
ENV=development
PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/soccerkit?sslmode=disable

# JWT — generate a strong random value for anything deployed (`openssl rand -hex 32`).
# A deployed process refuses to boot with a placeholder or a secret under 32 bytes.
#
# There is no JWT_REFRESH_SECRET: refresh tokens are opaque random strings stored
# as rows, not JWTs, so there is nothing to sign them with.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Sign in with Apple (iOS app auth).
#  - APPLE_CLIENT_ID: the app's bundle identifier (the identity token's `aud`).
#  - DEV_APPLE_BYPASS=true: skip Apple signature verification for LOCAL DEV only.
# Set APPLE_CLIENT_ID and leave DEV_APPLE_BYPASS unset in production.
APPLE_CLIENT_ID=
DEV_APPLE_BYPASS=true

# CORS — comma-separated origins, or * for all
CORS_ORIGINS=*

# Reverse proxies in front of this process, as comma-separated CIDR blocks
# (e.g. "10.0.0.0/8" for an in-VPC load balancer). The rate limiter uses this to
# tell which X-Forwarded-For entry our own infrastructure wrote from the ones the
# caller wrote. Leave empty when nothing proxies this process: the client is then
# the TCP peer, and forwarding headers are ignored entirely.
#
# Getting it wrong fails closed rather than open — an unlisted proxy means every
# caller shares one rate-limit bucket — so an empty value is safe but a wrong one
# is not free.
TRUSTED_PROXIES=

# --- Push notifications (APNs) -------------------------------------------------
# All four together, or none. With none set, push is off and invitations simply do
# not notify anyone -- which is what a developer's machine should do. Three of four
# is refused at boot, because the failure it otherwise produces (invitations that
# quietly tell nobody) is invisible until someone complains they were never told.
#
# APNS_PRIVATE_KEY is the .p8 Apple issues, PEM and all. Newlines may be written as
# \n; they are restored on load.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=
# Sandbox by default. A token minted by a sandbox build is rejected by production and
# vice versa -- the usual cause of BadDeviceToken on a token that looks well formed.
APNS_PRODUCTION=false
